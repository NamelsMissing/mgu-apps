{
  "id": "custom_cluster",
  "title": "Custom Cluster",
  "description": "KOMBI-only selected-layout parked tests and reliable text diagnostics.",
  "version": "0.6.7",
  "vendor": "custom",
  "loggingId": "OAQ7",
  "iconGlyph": "CC",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Custom Cluster",
      "buttons": [
        [
          "BTN_TEST",
          "Test KOMBI"
        ],
        [
          "BTN_DIAG",
          "Diagnostics"
        ],
        [
          "BTN_QR",
          "QR logs"
        ],
        [
          "BTN_LOG",
          "Live Logs"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "layout",
      "label": "Cluster layout",
      "type": "choice",
      "default": "stock",
      "options": [
        [
          "stock",
          "BMW original (unchanged)"
        ],
        [
          "sixwb",
          "BMW 6WB digital"
        ],
        [
          "oem",
          "G21 OEM-style recreation"
        ],
        [
          "g80",
          "G80-inspired design"
        ],
        [
          "sport",
          "M Sport"
        ],
        [
          "classic",
          "Classic dials"
        ],
        [
          "minimal",
          "Minimal digital"
        ]
      ]
    },
    {
      "key": "wazeMap",
      "label": "Waze map in cluster",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Keep Waze's own setting"
        ],
        [
          "on",
          "Show Waze map"
        ],
        [
          "off",
          "Hide Waze map"
        ]
      ]
    },
    {
      "key": "enablePanelTests",
      "label": "Allow experimental KOMBI tests",
      "type": "bool",
      "default": false
    },
    {
      "key": "coverOriginal",
      "label": "Cover original dials during KOMBI test",
      "type": "bool",
      "default": true
    },
    {
      "key": "sixwbTheme",
      "label": "6WB driving display",
      "group": "6WB",
      "type": "choice",
      "default": "comfort",
