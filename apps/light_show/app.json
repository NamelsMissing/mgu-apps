{
  "id": "light_show",
  "title": "Light Show",
  "description": "FLM02-only experimental LED channel diagnostics for BMW ID7: individually controlled left/right headlamp LEDs with configurable PWM and finite pulses, OEM stop routine, recovery and log export. Legacy BDC/timed controls hidden.",
  "version": "0.2.5",
  "vendor": "custom",
  "loggingId": "OAL9",
  "iconGlyph": "LS",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
