      "default": "alternate",
      "options": [
        [
          "alternate",
          "Alternate L/R"
        ],
        [
          "double",
          "Double L/R"
        ],
        [
          "triple",
          "Triple L/R"
        ],
        [
          "together",
          "Both together"
        ]
      ]
    },
    {
      "key": "interval",
      "label": "Requested flash interval",
      "type": "choice",
      "default": "100",
