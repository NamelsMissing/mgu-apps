{
  "id": "light_flasher",
  "title": "Light Flasher",
  "description": "Compact parked flash control with optional lever trigger in P (also with the app closed via autostart), one diagnostics page, requested intervals 100–1000 ms; experimental 20–80 ms in parked fast mode only.",
  "version": "0.1.17",
  "vendor": "custom",
  "loggingId": "OLF1",
  "iconGlyph": "LF",
  "showRepoCredits": false,
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusLightStatus": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "settings": [
    {
      "key": "enabled",
      "label": "Enable diagnostic mode (no lamp commands)",
      "type": "bool",
      "default": false
    },
    {
      "key": "backgroundMonitor",
      "label": "Background status monitor (read only)",
      "type": "bool",
      "default": true
    },
    {
      "key": "manualFlash",
      "label": "Enable manual parked flash (private property only)",
      "type": "bool",
      "default": false
    },
    {
      "key": "fastTest",
      "label": "Test: fast mode (no 150 ms gap, PWM 0 instead of STOP between pulses)",
      "type": "bool",
      "default": false
    },
    {
      "key": "leverTrigger",
      "label": "Start pattern by short lever flash (P only)",
      "type": "bool",
      "default": false
    },
    {
      "key": "leverBackground",
      "label": "Lever trigger also with app closed (autostart, P only)",
      "type": "bool",
      "default": false
    },
    {
      "key": "pattern",
      "label": "Flash pattern",
      "type": "choice",
      "default": "alternate",
      "options": [
        [
          "alternate",
          "Alternate L/R"
        ],
        [
          "double",
          "Double L/R"
        ],
        [
          "triple",
          "Triple L/R"
        ],
        [
          "together",
          "Both together"
        ]
      ]
    },
    {
      "key": "interval",
      "label": "Requested interval (ms)",
      "type": "choice",
      "default": "100",
      "options": [
        [
          "20",
          "20 ms (fast / P only)"
        ],
        [
          "40",
          "40 ms (fast / P only)"
        ],
        [
          "60",
          "60 ms (fast / P only)"
        ],
        [
          "80",
          "80 ms (fast / P only)"
        ],
        [
          "100",
          "100 ms"
        ],
        [
          "150",
          "150 ms"
        ],
        [
          "200",
          "200 ms"
        ],
        [
          "300",
          "300 ms"
        ],
        [
          "500",
          "500 ms"
        ],
        [
          "1000",
          "1000 ms"
        ]
      ]
    },
    {
      "key": "hold",
      "label": "Flash duration",
      "type": "choice",
      "default": "3000",
      "options": [
        [
          "2000",
          "2 s"
        ],
        [
          "3000",
          "3 s"
        ],
        [
          "4000",
          "4 s"
        ],
        [
          "5000",
          "5 s"
        ]
      ]
    }
  ],
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Light Flasher",
      "settings": true,
      "items": [
        [
          "text3",
          "FLASH_CONFIG",
          "Saved flash settings"
        ],
        [
          "button",
          "BTN_FLASH",
          "Start flash pattern (P)"
        ],
        [
          "button",
          "BTN_FLASH_STOP",
          "Stop"
        ],
        [
          "button",
          "BTN_RECOVER",
          "Restore normal lights (P)"
        ],
        [
          "text3",
          "LEVER_STATUS",
          "Lever: off"
        ],
        [
          "text3",
          "FLASH_STATUS",
          "Idle"
        ],
        [
          "text3",
          "FLASH_RESULT",
          "No result yet"
        ],
        [
          "button",
          "BTN_DIAG",
          "Diagnostics"
        ],
        [
          "text3",
          "NOTICE",
          "Parked test only (P). Lever trigger optionally also with the app closed. Private property. Automatic JSON log."
        ]
      ]
    },
    {
      "name": "DIAGNOSTICS",
      "kind": "menu",
      "title": "Light Flasher | Diagnostics",
      "items": [
        [
          "text3",
          "DIAG_STATE",
          "Connection status"
        ],
        [
          "text3",
          "DIAG_RESULT",
          "Last flash and return status"
        ],
        [
          "button",
          "BTN_CHECK",
          "Check BDC connection"
        ],
        [
          "button",
          "BTN_START",
          "Record stalk status (60 s)"
        ],
        [
          "button",
          "BTN_STOP",
          "Stop recording"
        ],
        [
          "button",
          "BTN_FEEDBACK",
          "Read FLM light status"
        ],
        [
          "text3",
          "DIAG_CAPTURE",
          "Read-only test status"
        ],
        [
          "button",
          "BTN_SAVE",
          "Save full diagnostic JSON"
        ],
        [
          "scroll",
          "DIAG_LOG",
          "Recent diagnostic details"
        ],
        [
          "button",
          "BTN_BACK",
          "Back"
        ]
      ]
    }
  ],
  "mguAppStartType": "autostart"
}
