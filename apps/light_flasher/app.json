{
  "id": "light_flasher",
  "title": "Light Flasher",
  "description": "Compact flash control, separate settings and service tools; automatic diagnostic reports.",
  "version": "0.1.18",
  "vendor": "custom",
  "loggingId": "OLF1",
  "iconGlyph": "LF",
  "showRepoCredits": false,
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusLightStatus": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
