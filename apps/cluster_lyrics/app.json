{
  "id": "cluster_lyrics",
  "title": "Cluster Lyrics",
  "description": "Shows the synchronised lyrics of the song playing on your Spotify account, optionally in the instrument cluster's map window with a compact overlay for Waze coexistence.",
  "version": "0.1.5",
  "mguInternet": true,
  "vendor": "custom",
  "loggingId": "OCL1",
  "iconGlyph": "LY",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Cluster Lyrics",
      "buttons": [
        [
          "BTN_KOMBI",
          "KOMBI lyrics: Off"
        ],
        [
          "BTN_PAGE",
          "Setup"
        ],
        [
          "BTN_ACTION",
          "Reload lyrics"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "kombiOn",
      "label": "Show lyrics in the instrument cluster (works without the menu)",
      "type": "bool",
      "default": false
    },
    {
      "key": "autoStartOnBoot",
      "label": "Autostart KOMBI lyrics when iDrive starts",
      "type": "bool",
      "default": true
    },
    {
      "key": "kombiMode",
      "label": "When lyrics may be shown",
      "type": "choice",
      "default": "parked",
      "options": [
        [
          "parked",
          "Only at a standstill"
        ],
        [
          "always",
          "Also while driving"
        ]
      ]
    },
    {
      "key": "takeOverBmwMap",
      "label": "Also replace BMW's own map (not only Waze)",
      "type": "bool",
      "default": false
    },
    {
      "key": "layoutMode",
      "label": "KOMBI display: lyrics only or together with Waze",
      "type": "choice",
      "default": "exclusive",
      "options": [
        [
          "exclusive",
          "Lyrics only (replace map)"
        ],
        [
          "withWaze",
          "Lyrics + Waze map (transparent overlay)"
        ]
      ]
    },
    {
      "key": "kombiFontPct",
      "label": "KOMBI lyrics font size",
      "type": "number",
      "default": 75,
      "unit": "%",
      "steps": [
        50,
        60,
        70,
        75,
        80,
        85,
        90,
        100,
        110,
        120
      ]
    },
    {
      "key": "showNext",
      "label": "Show the next line",
      "type": "bool",
      "default": true
    },
    {
      "key": "accent",
      "label": "Colour of the current line",
      "type": "choice",
      "default": "white",
      "options": [
        [
          "white",
          "White"
        ],
        [
          "green",
          "Green"
        ],
        [
          "amber",
          "Amber"
        ],
        [
          "blue",
          "Blue"
        ]
      ]
    },
    {
      "key": "offsetMs",
      "label": "Lyrics delay",
      "type": "number",
      "default": 0,
      "unit": "ms",
      "steps": [
        -2000,
        -1500,
        -1000,
        -750,
        -500,
        -250,
        0,
        250,
        500,
        750,
        1000,
        1500,
        2000,
        2500,
        3000
      ]
    }
  ],
  "mguAppStartType": "autostart"
}
