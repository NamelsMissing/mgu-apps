{
  "id": "mgu-phone-bridge",
  "kind": "tool",
  "version": "0.1.6",
  "title": "Phone Terminal Bridge",
  "description": "Authenticated mobile root terminal for the MGU",
  "mguHmi": ["ID7"],
  "files": [
    {"path": "mgu-phone-bridge", "mode": "0755"},
    {"path": "firewall.js", "mode": "0644"},
    {"path": "server.js", "mode": "0644"},
    {"path": "public/index.html", "mode": "0644"},
    {"path": "public/client.js", "mode": "0644"},
    {"path": "public/style.css", "mode": "0644"}
  ],
  "units": [{"name": "mgu-phone-bridge.service", "from": "mgu-phone-bridge.service"}],
  "enable": [{"unit": "mgu-phone-bridge.service", "target": "multi-user.target"}],
  "recmgr": ["mgu-phone-bridge"],
  "restart": ["mgu-phone-bridge.service"]
}
